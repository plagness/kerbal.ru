// dalnyak-mun-audit.ks — чекер по задаче и по планете для «Дальняк-Мун».
// Текущий профиль: развод созвездия из 4 спутников на орбите Муна + сама
// шина садится и передаёт отчёт (без обратного взлёта). Прогонять на
// столе ДО пуска.
//
//   RUNPATH("0:/check/dalnyak-mun-audit.ks").

RUNONCEPATH("0:/lib/audit.ks").

LOCAL fail IS 0.

SET fail TO fail + q_report("SCANsat: высотометрия низкого разрешения", q_taskScanAltimetry()).
SET fail TO fail + q_report("SCANsat: мультиспектральный (биомы)", q_taskScanBiome()).
SET fail TO fail + q_report("Созвездие: 4 спутника", q_taskConstellation(4, "sat-")).
SET fail TO fail + q_report("Мун: топливо на весь профиль (перелёт+захват+развод+посадка)",
                             q_bodyChecklist(q_bodyMunTour())).

PRINT "== чекер не видит: ==".
PRINT "  - хватит ли Δv на манёвр смены плоскости, если часть спутников идёт на полярное покрытие —".
PRINT "    это разовый дорогой манёвр (~770 м/с на 90°), общий бюджет его не различает;".
PRINT "  - мягкая ли будет посадка самой шины (опоры, тяговооружённость);".
PRINT "  - дотянется ли связь спутников друг до друга и до Кербина — считай через Antenna Helper.".

IF fail = 0 {
  PRINT "== всё, что видно чекеру, — на месте ==".
} ELSE {
  PRINT "== не хватает " + fail + " пункт(ов) — смотри отчёты выше ==".
}
