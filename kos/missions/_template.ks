// _template.ks — новая миссия за пять строк.
// Говоришь целевую орбиту — остальное считается само: азимут, окно пуска,
// схема выведения, число и место прожигов.
//   RUNPATH("0:/missions/моя-миссия.ks").

RUNONCEPATH("0:/lib/mission.ks").

SET s TO m_defaults().
SET s["name"] TO "Моя миссия".
SET s["ap"]  TO 100000.     // целевой апоцентр, м
SET s["pe"]  TO 100000.     // перицентр, м (или убери строку — будет круговая)
SET s["inc"] TO 0.          // наклонение, °
SET s["lan"] TO -1.         // долгота узла, ° (-1 = не ждать окна)
SET s["aop"] TO -1.         // аргумент перицентра, ° (-1 = не важен)
SET s["log"] TO "0:/my.csv".

m_orbit(s).
