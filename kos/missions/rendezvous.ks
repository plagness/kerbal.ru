// missions/rendezvous.ks — догнать выбранную цель и подойти на 100 м.
// kerbal.ru · сборка «Оператор»
//
// Перед запуском: выбери цель в игре (правый клик по аппарату на карте →
// «Установить как цель») либо задай именем в строке ниже.
// Аппарат должен быть уже на орбите — это операция, а не запуск.

RUNONCEPATH("0:/lib/rendezvous.ks").

// SET TARGET TO VESSEL("Станция-1").   // раскомментируй, если удобнее по имени

IF NOT HASTARGET {
  PRINT "× цель не выбрана. Укажи цель в игре и запусти снова.".
} ELSE {
  r_go(TARGET, 100).
}
