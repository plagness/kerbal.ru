// dalnyak-mun.ks — Дальняк-Мун: пробный вылет на покрытие + заработок.
// Профиль (финальный): сначала все 4 спутника, наука по ходу развода,
// потом шина садится сама на стороне Муны, обращённой к Кербину, и
// остаётся ретранслятором. Обратного взлёта нет.
//
// Наклонение задавай на пуске у Кербина (приполярная опорная, ~85–90°) —
// смена плоскости уже у Муна дорога, см. [[rendezvous]]. Если часть
// спутников должна прикрыть полюса — один плоскостной манёвр НА ОРБИТЕ
// МУНА (~770 м/с на 90°) дороже, чем на старте, но это одна дорогая
// операция на всю миссию, не четыре.
//
// Про сторону посадки: связь тут стоковый CommNet, антенна не наводится —
// сторону выбираем не ради «направления антенны», а потому что тело Муны
// на обратной стороне перекрывает видимость Кербина всегда. l_waitFacing
// гарантирует полушарие, не точку — снос при спуске небольшой относительно
// размера Муны, но не нулевой.
//
// Метки декаплеров — sat-1 / sat-2 / sat-3 / sat-4, расставлены заранее
// в VAB (правый клик по декаплеру → Rename tag).
//
// Раскрытие панелей/антенны и настройку каждого спутника ПОСЛЕ отстыковки
// эта миссия не делает и не может — шина не управляет тем, что уже
// отделилось. Вместо этого на CPU КАЖДОГО спутника в VAB поставь
// загрузочный файл boot/sat-boot.ks (правый клик по процессору → Boot
// File → sat-boot) — он выполнится сам сразу после отстыковки, пока
// физика ещё считается для обоих аппаратов. Подробности — kos/README.md,
// раздел «Загрузочные файлы».
//
//   RUNPATH("0:/missions/dalnyak-mun.ks").

RUNONCEPATH("0:/lib/deepspace.ks").

SET s TO ds_defaults().
SET s["name"]     TO "Дальняк-Мун".
SET s["body"]     TO MUN.
SET s["parkAlt"]  TO 100000.                    // рабочая орбита созвездия
SET s["mapAlt"]   TO 0.                         // не поднимаемся — шина садится сама
SET s["landers"]  TO LIST("sat-1", "sat-2", "sat-3", "sat-4").
SET s["selfLand"] TO TRUE.
SET s["faceBody"] TO KERBIN.                    // сесть на сторону, обращённую к Кербину
SET s["sci"]      TO TRUE.                      // наука на каждом рубеже и при каждом спутнике

ds_run(s).
