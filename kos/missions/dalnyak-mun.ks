// dalnyak-mun.ks — Дальняк-Мун: шина. Файл миссии = только параметры,
// вся механика (переход, подгонка прицела, захват, выпуск лендеров,
// картографическая орбита) — в lib/deepspace.ks.
//
// Архитектура: лёгкая шина + отделяемые зонды, а не один тяжёлый аппарат
// «и картограф, и посадка». Дорогой перелёт и захват оплачивается ОДИН раз
// всей связкой, у каждого лендера остаётся только свой дешёвый деорбит.
// Экономика — в вики: [[missiya-mun]].
//
// Наклонение задавай на пуске у Кербина (приполярная опорная, ~85–90°) —
// смена плоскости уже у Муна дорога, см. [[rendezvous]].
//
// Метки декаплеров — lander-1 / lander-2 / lander-3, расставлены заранее
// в VAB (правый клик по декаплеру → Rename tag).
//
//   RUNPATH("0:/missions/dalnyak-mun.ks").

RUNONCEPATH("0:/lib/deepspace.ks").

SET s TO ds_defaults().
SET s["name"]    TO "Дальняк-Мун".
SET s["body"]    TO MUN.
SET s["parkAlt"] TO 18000.
SET s["mapAlt"]  TO 250000.
SET s["landers"] TO LIST("lander-1", "lander-2", "lander-3").
SET s["sci"]     TO TRUE.

ds_run(s).
