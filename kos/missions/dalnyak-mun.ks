// dalnyak-mun.ks — Дальняк-Мун: пробный вылет на покрытие + заработок.
// Файл миссии = только параметры, вся механика (переход, подгонка прицела,
// захват, развод спутников, посадка шины) — в lib/deepspace.ks.
//
// Профиль этой операции: захват на рабочую орбиту → развод четырёх
// спутников US на созвездие (остаются на орбите, картографическая орбита
// шине больше не нужна) → сама шина садится и передаёт отчёт.
// Без обратного взлёта — это меняет бюджет Δv кардинально, разбор в чате.
//
// Наклонение задавай на пуске у Кербина (приполярная опорная, ~85–90°) —
// смена плоскости уже у Муна дорога, см. [[rendezvous]]. Если часть
// спутников должна прикрыть полюса — один плоскостной манёвр НА ОРБИТЕ
// МУНА дороже, чем на старте, но дешевле, чем несколько таких манёвров.
//
// Метки декаплеров — sat-1 / sat-2 / sat-3 / sat-4, расставлены заранее
// в VAB (правый клик по декаплеру → Rename tag).
//
//   RUNPATH("0:/missions/dalnyak-mun.ks").

RUNONCEPATH("0:/lib/deepspace.ks").

SET s TO ds_defaults().
SET s["name"]     TO "Дальняк-Мун".
SET s["body"]     TO MUN.
SET s["parkAlt"]  TO 100000.                    // рабочая орбита созвездия
SET s["mapAlt"]   TO 0.                         // не поднимаемся — шина садится сама
SET s["landers"]  TO LIST("sat-1", "sat-2", "sat-3", "sat-4").
SET s["selfLand"] TO TRUE.
SET s["sci"]      TO TRUE.                      // передать отчёт после посадки

ds_run(s).
