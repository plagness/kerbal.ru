// dalnyak-mun.ks — Дальняк-Мун: пробный вылет на покрытие + заработок.
// Профиль (финальный): сначала все 5 спутников, наука по ходу развода,
// потом шина садится сама на стороне Муны, обращённой к Кербину, и
// остаётся ретранслятором. Обратного взлёта нет.
//
// Наклонение задано на пуске у Кербина (приполярная опорная, ~85°,
// см. missions/dalnyak-mun-ascent.ks) — рабочая орбита у Муна и так
// получится приполярной, доп. манёвр смены плоскости не нужен. Это же
// даёт сканерам почти полное покрытие Муна бесплатно: полярная орбита,
// поддержанная достаточно долго, сама подставляет поверхность под
// полосу за счёт вращения тела, см. [[geologiya]] — скакать между
// разными плоскостями ради покрытия не нужно, это не так работает.
//
// Про сторону посадки: связь тут стоковый CommNet, антенна не наводится —
// сторону выбираем не ради «направления антенны», а потому что тело Муны
// на обратной стороне перекрывает видимость Кербина всегда. l_waitFacing
// гарантирует полушарие, не точку — снос при спуске небольшой относительно
// размера Муны, но не нулевой.
//
// ТЕГОВ НА ДЕКАПЛЕРАХ НЕТ — VAB не прокачан до переименования деталей.
// Отделяем по НАЗВАНИЮ: все 5 «US: Базовый субспутник» одинаковые и
// неотличимы, ds_release(selector) при отсутствии тега ищет ПЕРВУЮ ещё
// прикреплённую деталь с таким названием — после каждого отделения в
// списке остаются только уцелевшие, так и идёт по одному. Когда VAB
// прокачаешь — просто смени строки на теги, код меняться не должен.
//
// У каждого субспутника — СВОЙ декаплер (модуль USDecouple, событие
// "отделить"), своя антенна, свой пробник. Раскрывать/настраивать их
// после отстыковки шине не нужно — они и так укомплектованы.
//
//   RUNPATH("0:/missions/dalnyak-mun.ks").

RUNONCEPATH("0:/lib/deepspace.ks").

SET s TO ds_defaults().
SET s["name"]     TO "Дальняк-Мун".
SET s["body"]     TO MUN.
SET s["parkAlt"]  TO 100000.                    // рабочая орбита созвездия
SET s["mapAlt"]   TO 0.                         // не поднимаемся — шина садится сама
SET s["landers"]  TO LIST("Базовый субспутник", "Базовый субспутник",
                           "Базовый субспутник", "Базовый субспутник",
                           "Базовый субспутник").
SET s["selfLand"] TO TRUE.
SET s["faceBody"] TO KERBIN.                    // сесть на сторону, обращённую к Кербину
SET s["sci"]      TO TRUE.                      // наука на каждом рубеже и при каждом спутнике

ds_run(s).
