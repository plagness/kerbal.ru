// dalnyak-mun-ascent.ks — подъём «Дальняк-Мун» со стартового стола на
// опорную орбиту Кербина. Отдельный шаг ПЕРЕД missions/dalnyak-mun.ks —
// та миссия перелёта начинается уже с орбиты, подъёмом сама не занимается.
//
// Наклонение 85° — приполярное, задано заранее, а не подгоняется потом:
// смена плоскости уже у Муна дорога (~770 м/с на 90°), см. [[rendezvous]]
// и [[missiya-mun]]. Долгота узла не важна для перелёта к Муну — окно
// вылета script посчитает и дождётся сам (см. ниже).
//
//   RUNPATH("0:/missions/dalnyak-mun-ascent.ks").
//   // затем, уже на орбите:
//   RUNPATH("0:/missions/dalnyak-mun.ks").

RUNONCEPATH("0:/lib/mission.ks").

SET s TO m_defaults().
SET s["name"] TO "Дальняк-Мун: подъём".
SET s["ap"]   TO 80000.
SET s["inc"]  TO 85.

m_orbit(s).
